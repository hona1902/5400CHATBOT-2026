-- Migration 24: GraphRAG-03B durable deletion state (tombstone + delete event).
--
-- Records durable LOCAL intent to remove the derived LightRAG document whenever
-- a canonical Source is deleted through ANY path -- including a raw SurrealQL
-- `DELETE source` that runs no Python. The event fires inside the same
-- transaction as the canonical delete (SurrealDB v2 events are synchronous /
-- in-transaction), so the tombstone exists if and only if the source delete
-- committed. This is the exact guarantee the existing source_delete
-- vector-cleanup event (migration 1) already relies on -- no stronger claim.
--
-- INDEXING MAY FAIL OPEN. DELETION MAY NOT DISAPPEAR SILENTLY. This migration
-- provides the durable evidence half of that invariant. The HTTP drain that
-- actually deletes from LightRAG is GraphRAG-03C and is deliberately NOT here.
--
-- Additive and isolated: a separate `graphrag_source_delete` event; the
-- existing `source_delete` event is untouched. Removing the feature = migration
-- 24 down (drops table + event, restores baseline delete behavior).
--
-- The tombstone stores ONLY the canonical source identity + a timestamp + a
-- lifecycle status + a per-arm fence token. It holds NO document text, title,
-- URL, file path, notebook metadata, or credentials. doc_id is NOT stored: it is
-- derivable downstream as "doc-" + md5(source_id) (GraphRAGClient.compute_doc_id),
-- so 03C computes it and never needs a duplicate copy here.
--
-- arm_id: a fresh unique token generated by the event on EVERY arm/re-arm, via
-- SurrealDB's native rand::uuid() (verified on pinned v2.6.5: server-side, no
-- Python/HTTP, time-ordered UUIDv7, distinct per call, independent of
-- requested_at). It is the compare-and-set fence for GraphRAG-03C: a drain reads
-- {source_id, arm_id}, converges, then resolves ONLY where the row still has the
-- SAME arm_id. If the row was re-armed (deleted again) the token changed, the
-- stale drain's CAS matches zero rows, and the newer deletion intent is NOT
-- cleared. requested_at is NOT a safe fence (time::now() is not guaranteed unique
-- per re-arm); arm_id is. See GRAPHRAG_03B_DURABLE_DELETE.md section 17.1.1.
--
-- See docs/agribank/development/GRAPHRAG_03B_DURABLE_DELETE.md.

DEFINE TABLE IF NOT EXISTS graphrag_deletion SCHEMAFULL;

DEFINE FIELD IF NOT EXISTS source_id ON TABLE graphrag_deletion TYPE record<source>;
DEFINE FIELD IF NOT EXISTS requested_at ON TABLE graphrag_deletion TYPE datetime DEFAULT time::now();
DEFINE FIELD IF NOT EXISTS status ON TABLE graphrag_deletion TYPE string DEFAULT "pending";
DEFINE FIELD IF NOT EXISTS arm_id ON TABLE graphrag_deletion TYPE uuid;

DEFINE EVENT IF NOT EXISTS graphrag_source_delete ON TABLE source WHEN $after == NONE THEN {
    UPSERT type::thing("graphrag_deletion", $before.id) SET
        source_id = $before.id,
        requested_at = time::now(),
        status = "pending",
        arm_id = rand::uuid();
};
